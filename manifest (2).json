{
  "manifest_version": 3,
  "name": "Trendora Workflow",
  "version": "1.0.0",
  "description": "Workflow controls for Trendora.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
